DISCORD_BOT_TOKEN=replace-with-discord-token
OPENAI_API_KEY=replace-with-openai-api-key

# Optional paths
DATA_DIR=data
MEMORY_FILE=data/memory.json
DEFAULT_PROMPT_FILE=prompt.txt
SPECIAL_PROMPT_FILE=prompt_special.txt
NEWS_PROMPT_FILE=prompt_news.txt
BANDI_LOREBOOK_FILE=docs/bandi_lorebook.md
BANDI_EMOTICON_DIR=FireflyEmoticon

# Optional Bandi TTS settings
# Use BANDI_TTS_URL for a direct worker URL, or RUNPOD_ENDPOINT_ID/RUNPOD_API_KEY for RunPod runsync.
BANDI_TTS_URL=
BANDI_TTS_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
BANDI_TTS_TIMEOUT_SECONDS=300
RUNPOD_TTS_TIMEOUT_SECONDS=900
BANDI_TTS_MAX_CHARS=500
BANDI_TTS_MIN_DURATION_SECONDS=0
BANDI_TTS_RETRY_ATTEMPTS=1

# Bandi Cards web + bot integration
# Railway의 PostgreSQL DATABASE_URL을 웹과 봇 서비스에 같은 값으로 연결합니다.
DATABASE_URL=sqlite:///./bandi_cards.db
CARD_SITE_URL=http://localhost:8000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
CARD_SESSION_SECRET=replace-with-a-long-random-secret
CARD_SECURE_COOKIES=false
SPECIAL_USER_ID=393724092022390784

# Local card images. Railway production에서는 아래 S3 호환 저장소 사용을 권장합니다.
CARD_UPLOAD_DIR=data/card-images
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
