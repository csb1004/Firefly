DISCORD_BOT_TOKEN=replace-with-discord-token
OPENAI_API_KEY=replace-with-openai-api-key

# Optional paths
DATA_DIR=data
MEMORY_FILE=data/memory.json
DEFAULT_PROMPT_FILE=prompt.txt
SPECIAL_PROMPT_FILE=prompt_special.txt
NEWS_PROMPT_FILE=prompt_news.txt

# Optional voice settings
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_FALLBACK_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_REALTIME_TRANSCRIPTION_URL=wss://api.openai.com/v1/realtime?intent=transcription
VOICE_SUMMARY_MODEL=gpt-4.1-mini
VOICE_SUMMARY_FALLBACK_MODEL=gpt-4.1-mini
VOICE_TRANSCRIPT_LANGUAGE=ko
VOICE_RECORDING_RETENTION_DAYS=7
VOICE_SUMMARY_CHUNK_CHARS=50000
VOICE_TRANSCRIBER_QUEUE_SIZE=250
VOICE_TRANSCRIPTION_COMMIT_SECONDS=6.0
VOICE_TRANSCRIPTION_IDLE_COMMIT_SECONDS=2.0
VOICE_TRANSCRIPTION_MIN_COMMIT_MS=300
VOICE_FALLBACK_SESSION_MAX_SECONDS=120
